{
    "name": "waffle-commons/auth",
    "description": "The Universal Authentication Bridge for Waffle Commons (RFC-021): JWT, OAuth2/OIDC, HMAC assertions, API-key/Basic and WebAuthn passkeys behind one stateless, fail-closed authenticator surface.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Waffle\\Commons\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WaffleTests\\Commons\\Auth\\": "tests/src/"
        }
    },
    "authors": [
        {
            "name": "Leslie Petrimaux",
            "email": "contact@waffle-commons.cloud"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "ext-openssl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "waffle-commons/contracts": "self.version",
        "web-auth/webauthn-lib": "^5.3",
        "symfony/serializer": "^8.1",
        "symfony/uid": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "carthage-software/mago": "^1.29",
        "vimeo/psalm": "^6.16",
        "php-mock/php-mock-phpunit": "^2.15",
        "cyclonedx/cyclonedx-php-composer": "^6.2",
        "igor-php/igor-php": "^0.7.0",
        "spomky-labs/cbor-php": "^3.2",
        "web-auth/cose-lib": "^4.5"
    },
    "scripts": {
        "formatter": "vendor/bin/mago fmt",
        "linter": "vendor/bin/mago lint",
        "analyzer": "vendor/bin/mago analyze",
        "guard": "vendor/bin/mago guard",
        "igor": "vendor/bin/igor-php .",
        "phpunit": "vendor/bin/phpunit --log-junit var/data/phpunit-coverage/junit.xml --coverage-html var/data/phpunit-coverage",
        "benchmark": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpbench run --report=default_report --output=waffle_html --retry-threshold=10"
        ],
        "mago": [
            "@formatter",
            "@linter",
            "@analyzer",
            "@guard"
        ],
        "tests": [
            "@phpunit"
        ],
        "scan": [
            "@mago",
            "@tests"
        ],
        "ci": [
            "@mago",
            "@tests",
            "composer audit",
            "vendor/bin/psalm --taint-analysis"
        ]
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "cyclonedx/cyclonedx-php-composer": true
        }
    }
}
